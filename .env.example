# Supabase 프로젝트 설정 (https://supabase.com/dashboard 에서 발급)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# service_role 키 — 서버 사이드 전용. 절대 클라이언트에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 사이트 URL — 로컬은 http://localhost:3000, 배포는 실제 도메인.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 이벤트 게이트 강제 오버라이드 (선택)
# true: 시작 시간 도달 전이라도 모든 기능 오픈
# false: 시작 시간 도달 후에도 차단 유지 (긴급 잠금)
# 비워두면 lib/eventGate.ts의 EVENT_START_AT 기준으로 자동 판단
# FORCE_EVENT_OPEN=
# NEXT_PUBLIC_FORCE_EVENT_OPEN=
